# Docker Compose project
COMPOSE_PROJECT_NAME=firefly-logistics

# MySQL 8
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=firefly_logistics
MYSQL_SSL_MODE=DISABLED
MYSQL_USER=firefly
MYSQL_PASSWORD=firefly_dev_password
MYSQL_ROOT_PASSWORD=firefly_root_dev_password
# 可选：ZIP 版 MySQL 的绝对路径；配置后 start.cmd 可在端口未监听时启动该独立实例
# MYSQL_CLIENT_PATH=C:/path/to/mysql/bin/mysql.exe
# MYSQL_SERVER_PATH=C:/path/to/mysql/bin/mysqld.exe
# MYSQL_CONFIG_FILE=C:/path/to/mysql-instance/my.ini

# Redis 7（当前后端不强依赖，为缓存、幂等和分布式锁预留）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=firefly_redis_dev_password

# Backend
JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_TTL_HOURS=8
JWT_ISSUER=firefly-logistics
JWT_AUDIENCE=firefly-logistics-web
WAREHOUSE_SECURITY_ENABLED=true
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Firefly@123
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
WAREHOUSE_SERVICE_PORT=8082
AUTH_SERVICE_URL=http://localhost:8081
WAREHOUSE_SERVICE_URL=http://localhost:8082
CORS_ALLOWED_ORIGINS=http://localhost:5173
TOKEN_STATUS_CHECK_ENABLED=true
SPRINGDOC_ENABLED=true

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api
API_UPSTREAM=http://gateway:8080
