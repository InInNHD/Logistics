{
  admin off
  persist_config off
  auto_https off
  log {
    format json
  }
}

:{$PORT:80} {
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'"
  }

  @assets path /assets/*
  header @assets Cache-Control "public, max-age=31536000, immutable"
  header /index.html Cache-Control "no-cache"

  handle /health {
    respond "ok" 200
  }

  handle /api/* {
    reverse_proxy {$API_UPSTREAM:http://gateway:8080}
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
